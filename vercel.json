{
  "functions": {
    "api/download.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/azbuka/",
      "destination": "/azbuka",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/azbuka/api/:path*",
      "destination": "https://moja-prva-azbuka.vercel.app/azbuka/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/pretplata-sync",
      "schedule": "0 7 * * *"
    }
  ]
}
