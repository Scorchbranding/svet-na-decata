{
  "functions": {
    "api/download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/azbuka",
      "destination": "https://moja-prva-azbuka.vercel.app/azbuka"
    },
    {
      "source": "/azbuka/:path*",
      "destination": "https://moja-prva-azbuka.vercel.app/azbuka/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/pretplata-sync",
      "schedule": "0 7 * * *"
    }
  ]
}